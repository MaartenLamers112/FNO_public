# ============================================================
# Flask
# ============================================================

FLASK_ENV=development

SECRET_KEY=replace_with_random_secret_key
PUBLIC_BASE_URL=http://localhost:5000

# ============================================================
# Database
# ============================================================

# Standaard gebruikt FNO instance/fno.db.
# Stel DATABASE_URL alleen in voor een afwijkende databaseconfiguratie.

# ============================================================
# E-mail / accountverificatie
# ============================================================

EMAIL_VERIFICATION_MAX_AGE_SECONDS=86400

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SUPPRESS_SEND=false

# ============================================================
# Maior Memorix / BrabantCloud
# ============================================================

MM_API_BASE_URL=https://data.brabantcloud.nl/api
MM_API_KEY=
MM_LANGUAGE=nl
MM_DATASET_SPEC=enb-119-beeldmateriaal
MM_TIMEOUT_SECONDS=10

# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO

CONTACT_EMAIL=info@vortum-mullem.info

# ============================================================
# Gezichtsdetectie (OpenVINO)
# ============================================================

PERSON_DETECTION_MODEL_PATH=app/resources/face-detection-retail-0004.xml
PERSON_DETECTION_CONFIDENCE_THRESHOLD=0.20
PERSON_DETECTION_MAX_RESULTS=250
PERSON_DETECTION_LABEL_MARGIN=0.25
PERSON_DETECTION_EXISTING_RADIUS=0.035
